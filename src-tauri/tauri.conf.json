{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniDeck",
  "version": "0.1.0",
  "identifier": "com.omnideck.app",

  "build": {
    "frontendDist": "../frontend",
    "beforeDevCommand": "npm run build:css",
    "beforeBuildCommand": "npm run build:css"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["default"]
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../frontend/controller.html": "static/controller.html",
      "../frontend/output.html": "static/output.html",
      "../frontend/js": "static/js",
      "../frontend/css": "static/css",
      "../frontend/fonts": "static/fonts"
    }
  }
}
